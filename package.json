{
  "name": "kaku-chatgpt-harness",
  "version": "0.0.1",
  "description": "Production-grade local harness designed for ChatGPT controlling macOS through Kaku Terminal",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:daemon": "bun run --watch apps/harnessd/src/index.ts",
    "dev:cli": "bun run apps/harnessctl/src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --target=bun apps/harnessd/src/index.ts apps/harnessctl/src/index.ts --outdir dist",
    "verify": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "chatgpt",
    "mcp",
    "kaku",
    "local-harness",
    "agent-kernel",
    "mac-automation"
  ],
  "author": "Mamdouh Abo Ammar",
  "license": "MIT"
}
